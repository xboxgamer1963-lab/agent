GEMINI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
PIPEDRIVE_API_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
BATCH_SIZE=5
RELEVANCE_THRESHOLD=7
