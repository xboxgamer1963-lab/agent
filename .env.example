OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Paddle Billing — server-side API key (never expose in frontend)
PADDLE_API_KEY=
PADDLE_PRODUCT_ID=
PADDLE_PRICE_PRO=
PADDLE_PRICE_SCALE=
